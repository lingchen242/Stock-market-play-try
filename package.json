{
  "name": "stock-sim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "《股市模拟》—— 45 个交易日的 A 股投资模拟小游戏（单文件 HTML 交付，node_modules 管理图表库）",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test",
    "serve": "node server.mjs",
    "start": "node server.mjs",
    "electron:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File electron/setup.ps1",
    "electron:dev": "electron .",
    "electron:build": "powershell -NoProfile -ExecutionPolicy Bypass -File electron/build.ps1",
    "neutralino:prepare": "node neutralino/prepare-resources.mjs",
    "neutralino:build": "node neutralino/prepare-resources.mjs && neu build --release --embed-resources --clean && node neutralino/prune-dist.mjs",
    "neutralino:run": "node neutralino/prepare-resources.mjs && neu run"
  },
  "dependencies": {
    "lightweight-charts": "4.2.3"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "jsdom": "^29.1.1"
  }
}
